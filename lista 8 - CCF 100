# Questão  4
from datetime import datetime

print("=== SISTEMA DE AGENDAMENTO DA CLÍNICA ===")

for i in range(1, 6):
    print(f"\n--- Agendamento {i} de 5 ---")
    nome = input("Nome do paciente: ")
    data_str = input("Data da consulta (DD/MM/AAAA): ")
    
    data_atual = datetime.now().date()
    data_consulta = datetime.strptime(data_str, "%d/%m/%Y").date()
    dias_restantes = (data_consulta - data_atual).days
    
    print(f"\n● Nome do paciente: {nome}")
    print(f"● Data atual: {data_atual.strftime('%d/%m/%Y')}")
    print(f"● Data da consulta: {data_str}")
    print(f"● Quantidade de dias restantes: {dias_restantes}")

print("\n=== Processo encerrado ===")
