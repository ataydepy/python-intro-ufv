#Questão 1
num = int(input("Digite um número inteiro positivo: "))

soma = 0
resultado = ""  # transformar em string
for i in range(1, num + 1):
    if i % 2 != 0:  #impar
        soma += i
        if resultado == "":
            resultado += str(i)
        else:
            resultado += " + " + str(i)

print(f"{resultado} = {soma}")

# Questão 2
num = int(input("Digite um número inteiro positivo: "))

multiplicacao = 1
resultado = ""  
for i in range(num, 0, -1):
    multiplicacao *= i
    if resultado == "":
        resultado += str(i)
    else:
        resultado += " x " + str(i)

print(f"{num}! = {resultado} = {multiplicacao}")

