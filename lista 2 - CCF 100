def q6():
    a=float(input("Digite o valor de a:"))
    b=float(input("Digite o valor de b:"))
    c=float(input("Digite o valor de c:"))
    delta = (b)**2 - 4*(a*c)

    if delta < 0:
        return "Sua equação não tem resolução possível nos reais."
    elif delta == 0:
        equacao1 = (-b) / (2 * a)
        return f"Sua equação tem apenas uma solução nos reais e esse valor é {equacao1}"
    else:
        equacao1 = (-b + math.sqrt(delta)) / (2 * a)
        equacao2 = (-b - math.sqrt(delta)) / (2 * a)
        return f"Sua equação possui duas soluções nos reais, sendo x1 = {equacao1} e x2 = {equacao2}"
        
def q7(n1,n2,op):
    if op == "+":
        return n1+n2
    elif op == "-":
        return n1-n2
    elif op == "/":
        return n1/n2
    elif op == "*":
        return n1*n2
    elif op == "**":
        return n1**n2
    elif op == "sqrt":
        return math.sqrt(n1)
    else:
        return "Operação matemática inválida."

