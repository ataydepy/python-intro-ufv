import random

def q1():
    numero_aleatorio = random.randint(1, 100)
    while True:
        chute = int(input("Tente adivinhar o número entre 1 e 100: "))
        if chute < numero_aleatorio:
            print("O número é maior!")
        elif chute > numero_aleatorio:
            print("O número é menor!")
        else:
            print("Parabéns, você acertou!")
            break

def q2():
    nomes = ["Alice", "Bob", "Carlos", "Diana", "Eduardo"]
    vencedor = random.choice(nomes)
    print(f"O vencedor sorteado é: {vencedor}")

def q3():
    caras = 0
    coroas = 0
    for _ in range(5):
        lancamento = random.choice(["Cara", "Coroa"])
        print(f"Lançamento: {lancamento}")
        if lancamento == "Cara":
            caras += 1
        else:
            coroas += 1
    print(f"Total de Caras: {caras}")
    print(f"Total de Coroas: {coroas}")

def q4():
    valores = ["Ás", "2", "3", "4", "5", "6", "7", "8", "9", "10", "Valete", "Dama", "Rei"]
    naipes = ["Copas", "Espadas", "Ouros", "Paus"]
    valor = random.choice(valores)
    naipe = random.choice(naipes)
    print(f"A carta sorteada é: {valor} de {naipe}")

def q5():
    jogadores = ["Jogador1", "Jogador2", "Jogador3"]
    posicoes = {"Jogador1": 0, "Jogador2": 0, "Jogador3": 0}
    while True:
        for jogador in jogadores:
            passos = random.randint(1, 6)
            posicoes[jogador] += passos
            print(f"{jogador} avançou {passos} passos. Posição atual: {posicoes[jogador]}")
            if posicoes[jogador] >= 30:
                print(f"{jogador} venceu a corrida!")
                return

def main():
    opções = {
        "1": q1,
        "2": q2,
        "3": q3,
        "4": q4,
        "5": q5
    }

    while True:
        user_input = input("Escolha um exercício (1-5) ou 'sair' para encerrar: ")
        
        if user_input == 'sair':
            print("Sessão encerrada.")
            break
        
        if user_input not in opções:
            print("Opção inválida. Escolha um número de 1 a 5.")
            continue
        
        opções[user_input]()  # Executa a função correspondente ao exercício escolhido

if __name__ == "__main__":
    main()
