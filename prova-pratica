while p == "s":
    data = int(input("Digite o dia de seu pagamento:"))
    valor_m = float(input("Digite o valor de sua mensalidade:"))
    if data <=10:
        valor_com_desconto = (0.95 * valor_m)
        print(valor_com_desconto)

    elif 11 <= data <= 31:
        valor_com_acrescimo = (1.02 * valor_m)
        print(valor_com_acrescimo)
