import random
soma = 0
contador = 0

while contador <= 10:
    x = random.randint(0,40)
    soma += x 
    if x > 30:
        print(f"Alerta! Temperatura muito alta! {x} graus")
    else:
        print(f"Temperatura normal! {x} graus")
    contador +=1

media = soma/10
print(f"A média calculada foi de {media} graus!")


