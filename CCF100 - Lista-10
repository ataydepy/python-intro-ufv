# Questão 1
matriz = []
nula = True

for i in range(3):
    linha = []

    for j in range(3):
        valor = int(input(f"Digite o elemento da posição M[{i}][{j}]: "))
        linha.append(valor)

        if valor != 0:
            nula = False
            
    matriz.append(linha)

print("\n--- RESULTADO ---")
if nula:
    print("A matriz é nula!")
else:
    print("A matriz não é nula.")


