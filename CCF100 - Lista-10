Questão 7

matriz = []
identidade = True

for i in range(4):
linha = []
for j in range(4):
valor = int(input(f"Digite o elemento da posição M[{i}][{j}]: "))
linha.append(valor)
if (i == j and valor != 1) or (i != j and valor != 0):
identidade = False
matriz.append(linha)

print("\nMatriz:")
for linha in matriz:
print(linha)

if identidade:
print("\nA matriz é identidade")
else:
print("\nA matriz não é identidade")
